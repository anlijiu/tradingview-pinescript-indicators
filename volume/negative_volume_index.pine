indicator("Negative Volume Index", shorttitle = "NVI")

initial = input.int(100, title = "Initial Value")
signalType = input.string("EMA", title = "Signal Smoothing Type", options = ["EMA", "SMA"])
signalLength = input.int(255, title = "Signal Length")
highlightCrossovers = input.bool(false, title = "Highlight Crossovers")
applyFilling = input.bool(true, title = "Apply Ribbon Filling ?")

nvi = 0.0
nvi := na(nvi[1]) ? initial : (ta.change(volume) < 0 ? nvi[1] * close / close[1] : nvi[1])
signal = signalType == "EMA" ? ta.ema(nvi, signalLength) : ta.sma(nvi, signalLength)

trendColor = nvi > signal ? #0ebb23 : color.red

nviColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

nviPlot = plot(nvi, title = "NVI", color = nviColor)
signalPlot = plot(signal, title = "Signal", color = signalColor)

transparent = color.new(color.white, 100)

fillColor = applyFilling ? trendColor : transparent
fill(nviPlot, signalPlot, color = color.new(fillColor, 70))

plotshape(ta.crossover(nvi, signal) and highlightCrossovers ? nvi : na,
    title = "Crossover",
    location = location.absolute,
    style = shape.circle,
    size = size.tiny,
    color = color.green)
plotshape(ta.crossunder(nvi, signal) and highlightCrossovers ? nvi : na,
    title = "Crossunder",
    location = location.absolute,
    style = shape.circle,
    size = size.tiny,
    color = color.red)
