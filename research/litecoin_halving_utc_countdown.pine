indicator("Litecoin Halving UTC Countdown", overlay=true)

halvingDay = input.int(5, title="Halving Day", minval=1, maxval=31)
halvingHour = input.int(11, title="Halving Hour", minval=1, maxval=24)
halvingMinute = input.int(55, title="Halving Minute", minval=1, maxval=60)

halvingStamp = timestamp('GMT', 2019, 8, halvingDay, halvingHour, halvingMinute)

secondsRaw = math.floor((halvingStamp - timenow) / 1000)
minutesRaw = math.floor(secondsRaw / 60)
hoursRaw = math.floor(minutesRaw / 60)

seconds = secondsRaw % 60
minutes = minutesRaw % 60
hours = hoursRaw % 24
days = math.floor(hoursRaw / 24)

f_format(_val) =>
    (0 < _val and _val < 10 ? "0" : "") + str.tostring(_val, "##") + (_val == 0 ? "0" : "")

labelText = f_format(days) + "d  " + f_format(hours) + ":" + f_format(minutes) + ":" + f_format(seconds)

var label l = label.new(
     x=bar_index,
     y=na,
     text="",
     textcolor=color.black,
     style=label.style_none,
     size=size.huge
     )

label.set_text(l, labelText)
label.set_xy(l, bar_index, ta.highest(100))
