indicator("Custom Median vs Built-in Median", shorttitle = "CMvsBM")

length = input.int(14, title = "Length", minval = 1)
src = input.source(close, title = "Source")

// Built-in Median
median(src, length) =>
    ta.percentile_nearest_rank(src, length, 50)

sort(src, length, i) =>
    min = -10000.0

    for j = 0 to i
        min_local = 10000.0

        for l = 0 to length - 1
            if (nz(src[l]) <= min)
                continue

            min_local := math.min(min_local, math.max(min, nz(src[l])))

        if min_local != 10000
            min := min_local
    min

// Custom Median
customMedian(src, length) =>
    out = 0.0
    mid = math.floor(length / 2)

    if length % 2 == 0
        out := (sort(src, length, mid - 1) + sort(src, length, mid)) / 2
    else
        out := sort(src, length, mid)
    out

diff = median(src, length) - customMedian(src, length)

plot(diff, title = "CMvsBM")
