indicator("All-Time High Days", shorttitle = "ATH Days", precision = 0)

highlightATH = input.bool(false, title = "Highlight ATH ?")

ath = high
ath := na(ath[1]) ? ath : (high > ath[1] ? high : ath[1])

cond = high == ath
transparent = color.new(color.white, 100)

bars = ta.barssince(cond)
plot(bars, title = "ATH Days", color = #674ea7)

bgcolor(cond and highlightATH ? color.orange : transparent)
