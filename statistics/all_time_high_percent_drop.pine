indicator("All-Time High % Drop", shorttitle="ATH % Drop", precision=2)

ath = high
ath := na(ath[1]) ? ath : (high > ath[1] ? high : ath[1])

percent = 100 * (close - ath) / ath

plot(percent, title="ATH %", color=#351c75)

plot(0, title="", style=plot.style_circles, linewidth=1, color=color.gray)
hline(0, linestyle=hline.style_dotted, color=color.gray)

plot(-10, title="", style=plot.style_circles, linewidth=1, color=#F9CE02)
hline(-10, linestyle=hline.style_dotted, color=#F9CE02)

plot(-20, title="", style=plot.style_circles, linewidth=1, color=#F7BA05)
hline(-20, linestyle=hline.style_dotted, color=#F7BA05)

plot(-30, title="", style=plot.style_circles, linewidth=1, color=#F4A608)
hline(-30, linestyle=hline.style_dotted, color=#F4A608)

plot(-40, title="", style=plot.style_circles, linewidth=1, color=#F2920B)
hline(-40, linestyle=hline.style_dotted, color=#F2920B)

plot(-50, title="", style=plot.style_circles, linewidth=1, color=#F07E0E)
hline(-50, linestyle=hline.style_dotted, color=#F07E0E)

plot(-60, title="", style=plot.style_circles, linewidth=1, color=#ED6A10)
hline(-60, linestyle=hline.style_dotted, color=#ED6A10)

plot(-70, title="", style=plot.style_circles, linewidth=1, color=#EB5613)
hline(-70, linestyle=hline.style_dotted, color=#EB5613)

plot(-80, title="", style=plot.style_circles, linewidth=1, color=#E84216)
hline(-80, linestyle=hline.style_dotted, color=#E84216)

plot(-90, title="", style=plot.style_circles, linewidth=1, color=#E62E19)
hline(-90, linestyle=hline.style_dotted, color=#E62E19)

plot(-100, title="", style=plot.style_circles, linewidth=1, color=#E41A1C)
hline(-100, linestyle=hline.style_dotted, color=#E41A1C)
