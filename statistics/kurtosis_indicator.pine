indicator("Kurtosis Indicator", shorttitle = "Kurtosis")

momentumLength = input.int(3, title = "Momentum Length", minval = 1)
fastMAInput = input.string("EMA", title = "Fast MA", options = ["EMA", "SMA", "VWMA", "WMA"])
fastLength = input.int(66, title = "Fast Length", minval = 1)
fastSlowMAInput = input.string("SMA", title = "Fast/Slow MA", options = ["EMA", "SMA", "VWMA", "WMA"])
fastSlowLength = input.int(3, title = "Fast/Slow Length", minval = 1)
src = input.source(close, title = "Source")

// Kurtosis
K = ta.change(src, momentumLength) - ta.change(src[1], momentumLength)

// MA type selector
_ma(source, length, maType) =>
    switch maType
        "EMA"  => ta.ema(source, length)
        "SMA"  => ta.sma(source, length)
        "VWMA" => ta.vwma(source, length)
        "WMA"  => ta.wma(source, length)
        => na

// Fast Kurtosis
FK = _ma(K, fastLength, fastMAInput)

// Fast / Slow Kurtosis
FSK = _ma(FK, fastSlowLength, fastSlowMAInput)

hline(title = "Zero Level", price = 0, linestyle = hline.style_dotted, color = color.gray)

plot(FK, title = "Fast", linewidth = 2, color = #ff9370)
plot(FSK, title = "Fast / Slow", linewidth = 2, color = #6d1e7f)
