indicator("Kendall Rank Correlation Coefficient", shorttitle = "Kendall Correlation")

length = input.int(20, title = "Length")
sym1 = input.symbol("FX:AUDUSD", title = "1st Symbol")
sym2 = input.symbol("FOREXCOM:XAUUSD", title = "2nd Symbol")
src = input.source(close, title = "Source")

data1 = request.security(sym1, timeframe.period, src)
data2 = request.security(sym2, timeframe.period, src)

getKendall(data1, data2, length) =>
    totalPairs = length * (length - 1) / 2
    numerator = 0.0

    for i = 0 to length - 1
        for j = 0 to i
            numerator := numerator + math.sign(data1[i] - data1[j]) * math.sign(data2[i] - data2[j])

    numerator / totalPairs

kendallCorr = sym1 == sym2 ? 1 : getKendall(data1, data2, length)
pearsonCorr = ta.correlation(data1, data2, length)

plot(kendallCorr, title = "Kendall", color = color.orange)
plot(pearsonCorr, title = "Pearson", color = color.purple)
