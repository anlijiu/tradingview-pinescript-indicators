indicator("Recursive Median Filter", shorttitle = "RMF", overlay = true)

medianLength = input.int(5, title = "Length", minval = 1)
lowpassLength = input.int(12, title = "Lowpass Length", minval = 1)
src = input.source(close, title = "Source")

median(src, length) =>
    ta.percentile_nearest_rank(src, length, 50)

PI = 2 * math.asin(1)

alphaArg = 2 * PI / lowpassLength

alpha = 0.0
alpha := math.cos(alphaArg) != 0 ? (math.cos(alphaArg) + math.sin(alphaArg) - 1) / math.cos(alphaArg) : nz(alpha[1])

rmf = 0.0
rmf := alpha * median(src, medianLength) + (1 - alpha) * nz(rmf[1])

plot(rmf, title = "RMF", linewidth = 2, color = #6d1e7f)
