indicator("Ehlers Distance Coefficient Filter", shorttitle = "EDCF", overlay = true)

length = input.int(14, title = "Length")
src = input.source(hl2, title = "Source")

srcSum = 0.0
coefSum = 0.0

for count = 0 to length - 1
    distance = 0.0

    for lookback = 1 to length - 1
        distance := distance + math.pow(src[count] - src[count + lookback], 2)

    srcSum := srcSum + distance * src[count]
    coefSum := coefSum + distance

dcf = coefSum != 0 ? srcSum / coefSum : 0.0

plot(dcf, title = "EDCF", linewidth = 2, color = #6d1e7f)
