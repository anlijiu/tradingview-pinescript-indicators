indicator("McNicholl Moving Average", shorttitle="MNMA", overlay=true)

length = input.int(20, title="Length")
highlightMovements = input.bool(true, title="Highlight Movements ?")
src = input.source(close, title="Source")

alpha = 2 / (length + 1)

ema1 = ta.ema(src, length)
ema2 = ta.ema(ema1, length)

mnma = ((2 - alpha) * ema1 - ema2) / (1 - alpha)

mnmaColor = highlightMovements ? (mnma > mnma[1] ? color.green : color.red) : #6d1e7f
plot(mnma, title="MNMA", linewidth=2, color=mnmaColor)
