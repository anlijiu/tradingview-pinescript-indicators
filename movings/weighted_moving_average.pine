indicator("Weighted Moving Average", shorttitle="WMA", overlay=true)

length = input.int(14, title="Length", minval=1)
src = input.source(close, title="Source")

plot(ta.wma(src, length), title="WMA", linewidth=2, color=#6d1e7f)
