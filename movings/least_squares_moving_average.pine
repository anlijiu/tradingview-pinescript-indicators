indicator("Least Squares Moving Average", shorttitle="LSMA", overlay=true)

length = input.int(14, title="Length", minval=1)
offset = input.int(0, title="Offset")
src = input.source(close, title="Source")

plot(ta.linreg(src, length, offset), title="LSMA", linewidth=2, color=#6d1e7f)
