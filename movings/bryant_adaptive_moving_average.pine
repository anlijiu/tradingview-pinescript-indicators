indicator("Bryant Adaptive Moving Average", shorttitle="BAMA", overlay=true)

length = input.int(14, title="Length")
trendParam = input.float(-1, title="Trend Parameter", step=0.1)
maxLength = input.int(100, title="Max Length")
highlightMovements = input.bool(false, title="Highlight Movements ?")
src = input.source(close, title="Source")

mom = math.abs(ta.change(src, length))
volatility = math.sum(math.abs(ta.change(src)), length)

// Efficiency Ratio
er = volatility != 0 ? mom / volatility : 0

// Variable Efficiency Ratio
ver = math.pow(er - (2 * er - 1) / 2 * (1 - trendParam) + 0.5, 2)

vlength = (length - ver + 1) / ver
vlength := vlength > maxLength ? maxLength : vlength

valpha = 2 / (vlength + 1)

bama = src
bama := valpha * src + (1 - valpha) * nz(bama[1], bama)

bamaColor = highlightMovements ? (bama > bama[1] ? color.green : color.red) : #6d1e7f
plot(bama, title="BAMA", linewidth=2, color=bamaColor)
