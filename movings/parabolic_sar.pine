indicator(title="Parabolic SAR", shorttitle="PSAR", overlay=true)

start = input.float(0.02)
increment = input.float(0.02)
maximum = input.float(0.2)

psar = ta.sar(start, increment, maximum)

plot(psar, style=plot.style_cross, color=color.blue)
