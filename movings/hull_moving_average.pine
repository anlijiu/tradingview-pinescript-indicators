const string MA_SHORT_TITLE = "HMA"
indicator("Hull Moving Average", shorttitle = MA_SHORT_TITLE, overlay = true, behind_chart = false)

const string calcGroup = "Calculation"
length = input.int(14, minval = 1, title = "Length", group = calcGroup)
src = input.source(close, title = "Source", group = calcGroup)

const color maColor = #6d1e7f

//---

// The square-root smoothing length depends only on `length`, so compute it once instead of on every bar
var int sqrtLength = math.round(math.sqrt(length))

_hma(float src, int length, int sqrtLength) =>
    ta.wma(2 * ta.wma(src, math.floor(length / 2)) - ta.wma(src, length), sqrtLength)

//---

ma = _hma(src, length, sqrtLength)

//---

plot(ma, title = MA_SHORT_TITLE, linewidth = 2, color = maColor)

//---

alertcondition(ta.crossover(src, ma),
    title = "Price Crossed Over " + MA_SHORT_TITLE,
    message = "Price crossed over " + MA_SHORT_TITLE + "\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}")
alertcondition(ta.crossunder(src, ma),
    title = "Price Crossed Under " + MA_SHORT_TITLE,
    message = "Price crossed under " + MA_SHORT_TITLE + "\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}")
