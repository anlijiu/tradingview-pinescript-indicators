indicator("Middle-High-Low Moving Average", shorttitle = "MHLMA", overlay = true)

length = input.int(14, title = "Length", minval = 1)
mhlRange = input.int(10, title = "High-Low Range")
maType = input.string("EMA", title = "MA Type", options = ["EMA", "SMA"])
highlightMovements = input.bool(true, title = "Highlight Movements ?")

mhl = math.avg(ta.highest(mhlRange), ta.lowest(mhlRange))
mhlma = maType == "EMA" ? ta.ema(mhl, length) : ta.sma(mhl, length)

mhlmaColor = highlightMovements ? (mhlma > mhlma[1] ? color.green : color.red) : #6d1e7f

plot(mhlma, title = "MHLMA", linewidth = 2, color = mhlmaColor)
