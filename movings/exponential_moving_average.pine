const string MA_SHORT_TITLE = 'EMA'
indicator('Exponential Moving Average', shorttitle = MA_SHORT_TITLE, overlay = true, behind_chart = false)

const string calcGroup = 'Calculation'
length = input.int(14, minval = 1, title = 'Length', group = calcGroup)
src = input.source(close, title = 'Source', group = calcGroup)

const color maColor = #6d1e7f

//---

ma = ta.ema(src, length)

//---

plot(ma, title = MA_SHORT_TITLE, linewidth = 2, color = maColor)

//---

alertcondition(ta.crossover(src, ma), title = 'Price Crossed Over ' + MA_SHORT_TITLE, message = 'Price crossed over ' + MA_SHORT_TITLE + '\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}')
alertcondition(ta.crossunder(src, ma), title = 'Price Crossed Under ' + MA_SHORT_TITLE, message = 'Price crossed under ' + MA_SHORT_TITLE + '\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}')
