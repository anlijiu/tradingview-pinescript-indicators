indicator("Moving Harmonic Mean", shorttitle = "MHM", overlay = true)

length = input.int(14, title = "Length", minval = 1)
src = input.source(close, title = "Source")

mhm(src, length) =>
    sum = 0.0

    for i = 0 to length - 1
        sum := sum + 1 / (na(src[i]) ? 1 : src[i])

    length / sum

plot(mhm(src, length), title = "MHM", linewidth = 2, color = #6d1e7f)
