indicator("Multiple Hull Moving Average", shorttitle="HMA", overlay=true)

len1 = input.int(20, title="1st Length")
src1 = input.source(close, title="1st Source")
hma1 = ta.wma(2 * ta.wma(src1, len1 / 2) - ta.wma(src1, len1), math.round(math.sqrt(len1)))
plot(hma1, title="1", linewidth=2, color=#85200c)

len2 = input.int(50, title="2nd Length")
src2 = input.source(close, title="2nd Source")
hma2 = ta.wma(2 * ta.wma(src2, len2 / 2) - ta.wma(src2, len2), math.round(math.sqrt(len2)))
plot(hma2, title="2", linewidth=2, color=#1155cc)

len3 = input.int(100, title="3rd Length")
src3 = input.source(close, title="3rd Source")
hma3 = ta.wma(2 * ta.wma(src3, len3 / 2) - ta.wma(src3, len3), math.round(math.sqrt(len3)))
plot(hma3, title="3", linewidth=2, color=#f1c232)
