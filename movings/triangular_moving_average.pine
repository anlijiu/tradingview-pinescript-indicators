indicator("Triangular Moving Average", shorttitle="TMA", overlay=true)

length = input.int(20, title="Length", minval=1)
highlightMovements = input.bool(true, title="Highlight Movements ?")
src = input.source(close, title="Source")

tma = ta.sma(ta.sma(src, math.ceil(length / 2)), math.floor(length / 2) + 1)
tmaColor = highlightMovements ? (tma > tma[1] ? color.green : color.red) : #6d1e7f

plot(tma, title="TMA", linewidth=2, color=tmaColor)
