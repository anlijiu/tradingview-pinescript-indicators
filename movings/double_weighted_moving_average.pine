indicator("Double Weighted Moving Average", shorttitle="DWMA", overlay=true)

length = input.int(10, title="Length")
highlightMovements = input.bool(true, title="Highlight Movements ?")
src = input.source(close, title="Source")

dwma = ta.wma(ta.wma(src, length), length)

dwmaColor = highlightMovements ? (dwma > dwma[1] ? color.green : color.red) : #6d1e7f
plot(dwma, title="DWMA", linewidth=2, color=dwmaColor)
