indicator("Moving Geometric Mean", shorttitle="MGM", overlay=true)

length = input.int(14, title="Length", minval=1)
src = input.source(close, title="Source")

mgm(src, length) =>
	math.exp(math.sum(math.log(src), length) / length)

plot(mgm(src, length), title="MGM", linewidth=2, color=#6d1e7f)
