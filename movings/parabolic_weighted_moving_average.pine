indicator("Parabolic Weighted Moving Average", shorttitle = "PWMA", overlay = true)

length = input.int(14, title = "Length")
power = input.int(2, title = "Power", minval = 0)
highlightMovements = input.bool(true, title = "Highlight Movements ?")
src = input.source(close, title = "Source")

sum = 0.0
weightSum = 0.0

for i = 0 to length - 1
    weight = math.pow(length - i, power)
    sum := sum + nz(src[i]) * weight
    weightSum := weightSum + weight

pwma = sum / weightSum

pwmaColor = highlightMovements ? (pwma > pwma[1] ? color.green : color.red) : #6d1e7f
plot(pwma, title = "PWMA", linewidth = 2, color = pwmaColor)
