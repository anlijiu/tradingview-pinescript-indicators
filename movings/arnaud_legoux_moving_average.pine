indicator("Arnaud Legoux Moving Average", shorttitle = "ALMA", overlay = true)

length = input.int(9, title = "Length", minval = 1)
offset = input.float(0.85, title = "Offset")
sigma = input.float(6, title = "Sigma")
src = input.source(close, title = "Source")

plot(ta.alma(src, length, offset, sigma), title = "ALMA", linewidth = 2, color = #e69138)
