indicator("Trimean", shorttitle = "Trimean", overlay = true)

length = input.int(14, title = "Length", minval = 1)
src = input.source(close, title = "Source")
highlight = input.bool(true, title = "Highlight ?")

q1 = ta.percentile_nearest_rank(src, length, 25)
median = ta.percentile_nearest_rank(src, length, 50)
q3 = ta.percentile_nearest_rank(src, length, 75)

trimean = (q1 + 2 * median + q3) / 4

trimeanColor = highlight ? trimean > trimean[1] ? color.green : color.red : #6d1e7f
plot(trimean, title = "Trimean", linewidth = 2, color = trimeanColor)
