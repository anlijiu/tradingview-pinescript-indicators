const string MA_SHORT_TITLE = "KAMA"
indicator("Kaufman Adaptive Moving Average", shorttitle = MA_SHORT_TITLE, overlay = true, behind_chart = false)

const string calcGroup = "Calculation"
length = input.int(14, minval = 1, title = "Length", group = calcGroup)
fastLength = input.int(2, minval = 1, title = "Fast EMA Length", group = calcGroup)
slowLength = input.int(30, minval = 1, title = "Slow EMA Length", group = calcGroup)
src = input.source(close, title = "Source", group = calcGroup)

const string visualGroup = "Visuals"
const string highlightTooltip = "Colors the " + MA_SHORT_TITLE + " according to its direction:\n• Green = rising\n• Pink = falling"
highlight = input.bool(true, title = "Highlight ?", tooltip = highlightTooltip, group = visualGroup)

//---

mom = math.abs(ta.change(src, length))
volatility = math.sum(math.abs(ta.change(src)), length)

// Efficiency Ratio
er = volatility != 0 ? mom / volatility : 0

fastAlpha = 2 / (fastLength + 1)
slowAlpha = 2 / (slowLength + 1)

alpha = math.pow(er * (fastAlpha - slowAlpha) + slowAlpha, 2)

ma = 0.0
ma := alpha * src + (1 - alpha) * nz(ma[1], src)

//---

const color bullishColor = #09b71e
const color bearishColor = #e91e63
const color neutralColor = #6d1e7f

isBullishSlope = ma > ma[1]

maColor = highlight ? (isBullishSlope ? bullishColor : bearishColor) : neutralColor

//---

plot(ma, title = MA_SHORT_TITLE, linewidth = 2, color = maColor)

//---

alertcondition(maColor[1] != bullishColor and maColor == bullishColor,
    title = "Bullish Color Change",
    message = MA_SHORT_TITLE + " - Bullish Color Change\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}")
alertcondition(maColor[1] != bearishColor and maColor == bearishColor,
    title = "Bearish Color Change",
    message = MA_SHORT_TITLE + " - Bearish Color Change\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}")
alertcondition(maColor != maColor[1],
    title = "Any Color Change",
    message = MA_SHORT_TITLE + " - Any Color Change\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}")
