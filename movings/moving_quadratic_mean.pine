indicator("Moving Quadratic Mean (RMS)", shorttitle="RMS", overlay=true)

length = input.int(14, title="Length", minval=1)
src = input.source(close, title="Source")

rms(src, length) =>
	math.sqrt(math.sum(src * src, length) / length)

plot(rms(src, length), title="RMS", linewidth=2, color=#6d1e7f)
