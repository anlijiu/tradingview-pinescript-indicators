indicator("Damping Index", shorttitle="DI")

smaLength = input.int(5, title="SMA Length")
threshold = input.float(1.5, title="Threshold", step=0.1)

sma = ta.sma(high - low, smaLength)

di = sma[1] / sma[6]

diColor = di >= threshold ? #ff9800 : #3c78d8
plot(di, color=diColor)

hline(threshold, title="Threshold", linestyle=hline.style_dotted)

breakoutFillColor = di >= threshold ? #ff9800 : color.new(color.white, 100)
bgcolor(color.new(breakoutFillColor, 90))
