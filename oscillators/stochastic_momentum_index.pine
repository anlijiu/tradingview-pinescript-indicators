indicator("Stochastic Momentum Index", shorttitle="SMI")

q = input.int(13, title="Length (Stochastic Lookback)", minval=1)
r = input.int(25, title="First Smoothing Length", minval=1)
s = input.int(2, title="Second Smoothing Length", minval=1)
signalLength = input.int(12, title="Signal Length", minval=1)
overboughtLevel = input.int(40, title="Overbought Level")
oversoldLevel = input.int(-40, title="Oversold Level")
applyFilling = input.bool(false, title="Apply Filling ?")
src = input.source(close, title="Source")

hhq = ta.highest(high, q)
llq = ta.lowest(low, q)

numerator = ta.ema(ta.ema(src - 0.5 * (hhq + llq), r), s)

denominator = 0.5 * ta.ema(ta.ema(hhq - llq, r), s)

smi = 100 * numerator / denominator

signal = ta.ema(smi, signalLength)

smiPlot = plot(smi, title="SMI", color=#ff3e7d)
signalPlot = plot(signal, title="Signal", color=#3c78d8)

overbought = hline(title="Overbought Level", price=overboughtLevel, linestyle=hline.style_dotted, color=#e69138)
hline(title="Zero Level", price=0, linestyle=hline.style_dashed, color=#989898)
oversold = hline(title="Oversold Level", price=oversoldLevel, linestyle=hline.style_dotted, color=#e69138)

fillColor = applyFilling ? (smi > signal ? #0ebb23 : #cc0000) : color.new(color.white, 100)
fill(smiPlot, signalPlot, color=fillColor)
