indicator("Pretty Good Oscillator", shorttitle = "PGO")

length = input.int(14, title = "Length", minval = 1)
upperLevel = input.float(2.0, title = "Upper Level", step = 0.1)
lowerLevel = input.float(-2.0, title = "Lower Level", step = 0.1)
maxLevel = input.float(4.0, title = "Max Level", step = 0.1)
minLevel = input.float(-4.0, title = "Min Level", step = 0.1)
highlightBreakouts = input.bool(true, title = "Highlight Overbought/Oversold Breakouts ?")
src = input.source(close, title = "Source")

pgo = (src - ta.sma(src, length)) / ta.atr(length)

pgoColor = pgo > upperLevel ? #0ebb23 : pgo < lowerLevel ? #ff0000 : #f4b77d
plot(pgo, title = "PGO", linewidth = 2, color = pgoColor)

transparent = color.new(color.white, 100)

maxLevelPlot = hline(maxLevel, title = "Max Level", linestyle = hline.style_dotted, color = transparent)
upperLevelPlot = hline(upperLevel, title = "Upper Level", linestyle = hline.style_dotted)
hline(0, title = "Zero Level", linestyle = hline.style_dotted)
lowerLevelPlot = hline(lowerLevel, title = "Lower Level", linestyle = hline.style_dotted)
minLevelPlot = hline(minLevel, title = "Min Level", linestyle = hline.style_dotted, color = transparent)

fill(upperLevelPlot, lowerLevelPlot, color = color.new(color.purple, 95))

upperFillColor = pgo > upperLevel and highlightBreakouts ? color.green : transparent
lowerFillColor = pgo < lowerLevel and highlightBreakouts ? color.red : transparent

fill(maxLevelPlot, upperLevelPlot, color = color.new(upperFillColor, 90))
fill(minLevelPlot, lowerLevelPlot, color = color.new(lowerFillColor, 90))
