indicator("Recursive Median Oscillator", shorttitle = "RMO")

medianLength = input.int(5, title = "Length", minval = 1)
lowpassLength = input.int(12, title = "Lowpass Length", minval = 1)
highpassLength = input.int(30, title = "Highpass Length", minval = 1)
src = input.source(close, title = "Source")

median(src, length) =>
    ta.percentile_nearest_rank(src, length, 50)

PI = 2 * math.asin(1)

alpha1Arg = 2 * PI / lowpassLength
alpha1 = (math.cos(alpha1Arg) + math.sin(alpha1Arg) - 1) / math.cos(alpha1Arg)

rm = 0.0
rm := alpha1 * median(src, medianLength) + (1 - alpha1) * nz(rm[1])

alpha2Arg = 1 / math.sqrt(2) * 2 * PI / highpassLength
alpha2 = (math.cos(alpha2Arg) + math.sin(alpha2Arg) - 1) / math.cos(alpha2Arg)

rmo = 0.0
rmo := math.pow(1 - alpha2 / 2, 2) * (rm - 2 * nz(rm[1]) + nz(rm[2])) + 2 * (1 - alpha2) * nz(rmo[1]) - math.pow(1 - alpha2, 2) * nz(rmo[2])

rmoColor = rmo >= 0.0 ? #0ebb23 : #ff0000

plot(rmo, title = "RMO", linewidth = 2, color = rmoColor)

hline(0, title = "Zero Level", linestyle = hline.style_dashed, color = #3c78d8)
