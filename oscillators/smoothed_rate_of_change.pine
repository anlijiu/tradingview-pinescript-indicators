indicator("Smoothed Rate of Change", shorttitle = "S-RoC")

rocLength = input.int(21, title = "ROC Length", minval = 1)
smoothingLength = input.int(13, title = "Smoothing Length", minval = 1)
src = input.source(close, title = "Source")

ma = ta.ema(src, smoothingLength)

sroc = nz(ma[rocLength]) == 0
     ? 100
     : ma - nz(ma[rocLength]) == 0
          ? 0
          : 100 * (ma - nz(ma[rocLength])) / ma[rocLength]

srocColor = sroc >= 0.0 ? #0ebb23 : #ff0000

plot(sroc, title = "S-RoC", linewidth = 2, color = srocColor)

hline(0, title = "Zero Level", linestyle = hline.style_dotted, color = #989898)
