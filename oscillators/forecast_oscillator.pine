indicator("Forecast Oscillator", shorttitle="FOSC")

length = input.int(14, title="Length", minval=1)
src = input.source(close, title="Source")

fosc = 100 * (src - ta.linreg(src, length, 0)) / src

foscColor = fosc >= 0.0 ? #0ebb23 : #ff0000

plot(fosc, title="FOSC", linewidth=2, color=foscColor)

hline(0, title="Zero Level", linestyle=hline.style_dotted, color=#989898)
