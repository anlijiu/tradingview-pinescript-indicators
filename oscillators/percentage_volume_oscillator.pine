indicator("Percentage Volume Oscillator", shorttitle="PVO")

fastLength = input.int(12, title="Fast Length")
slowLength = input.int(26, title="Slow Length")
signalLength = input.int(9, title="Signal Length")
showHistogram = input.bool(true, title="Show Histogram ?")
highlightCrossovers = input.bool(true, title="Highlight PVO/Signal Crossovers ?")
highlightZeroCrossovers = input.bool(false, title="Highlight Zero Line Crossovers ?")
applyFilling = input.bool(false, title="Apply Ribbon Filling ?")

src = volume

pvo = 100 * (ta.ema(src, fastLength) - ta.ema(src, slowLength)) / ta.ema(src, slowLength)
signal = ta.ema(pvo, signalLength)

hist = pvo - signal
histColor = hist >= 0 ? (hist[1] < hist ? #26A69A : #B2DFDB) : (hist[1] < hist ? #FFCDD2 : #EF5350)

plot(showHistogram ? hist : na, title="Histogram", style=plot.style_columns, color=histColor)
hline(0, title="Zero Line", linestyle=hline.style_dotted)

trendColor = pvo > signal ? #0ebb23 : color.red
pvoColor = applyFilling ? trendColor : #0094ff
signalColor = applyFilling ? trendColor : #ff6a00

pvoPlot = plot(pvo, title="PVO", color=pvoColor)
signalPlot = plot(signal, title="Signal", color=signalColor)

transparent = color.new(color.white, 100)

fillColor = applyFilling ? trendColor : transparent
fill(pvoPlot, signalPlot, color=color.new(fillColor, 70))

zeroCrossBgColor = highlightZeroCrossovers ? (pvo > 0 ? color.green : color.red) : transparent
bgcolor(color.new(zeroCrossBgColor, 90))

crossoverSignal = ta.crossover(pvo, signal)
crossunderSignal = ta.crossunder(pvo, signal)

plotshape(highlightCrossovers and crossoverSignal ? pvo : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(highlightCrossovers and crossunderSignal ? pvo : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
