indicator("Didi Index")

curtaLength = input.int(3, title="Curta (Short) Length")
mediaLength = input.int(8, title="Media (Medium) Length")
longaLength = input.int(20, title="Longa (Long) Length")
src = input.source(close, title="Source")
applyFilling = input.bool(true, title="Apply Ribbon Filling ?")
highlightCrossovers = input.bool(true, title="Highlight Crossovers ?")

media = ta.sma(src, mediaLength)
curta = ta.sma(src, curtaLength) / media
longa = ta.sma(src, longaLength) / media

curtaPlot = plot(curta, title="Curta", color=color.green)
plot(1, title="Media", color=color.black)
longaPlot = plot(longa, title="Longa", color=color.red)

fillColor = applyFilling ? (curta > longa ? #0ebb23 : color.red) : color.new(color.white, 100) 
fill(curtaPlot, longaPlot, color=color.new(fillColor, 80))

plotshape(ta.crossover(curta, longa) and highlightCrossovers ? math.avg(longa, longa[1]) : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(color.green, 20))
plotshape(ta.crossunder(curta, longa) and highlightCrossovers ? math.avg(longa, longa[1]) : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(color.red, 20))
