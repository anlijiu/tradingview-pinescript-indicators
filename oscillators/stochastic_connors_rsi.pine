indicator(title = "Stochastic Connors RSI", shorttitle = "Stoch CRSI")

stochLength = input.int(3, title = "Stochastic Length", minval = 1)
smoothK = input.int(3, title = "K", minval = 1, maxval = 10000)
smoothD = input.int(3, title = "D", minval = 1, maxval = 10000)

rsiLength = input.int(3, title = "RSI Length", minval = 1)
updownLength = input.int(2, title = "Updown RSI Length", minval = 1)
rocLength = input.int(100, title = "ROC Length", minval = 1)
src = input.source(close, title = "RSI Source")

updown = 0
updown_calc(s, ud) =>
    newupdown = 0
    if s > s[1]
        newupdown := nz(ud[1]) >= 0 ? nz(ud[1]) + 1 : 1
    else
        if s < s[1]
            newupdown := nz(ud[1]) <= 0 ? nz(ud[1]) - 1 : -1
        else
            newupdown := 0

updown := updown_calc(src, updown)

updownrsi = ta.rsi(updown, updownLength)

rsi = ta.rsi(src, rsiLength)

percentrank = ta.percentrank(ta.roc(src, 1), rocLength)

crsi = math.avg(rsi, updownrsi, percentrank)

stochcalc = ta.stoch(crsi, crsi, crsi, stochLength)

band1 = hline(80, color = color.gray, linestyle = hline.style_dashed)
band2 = hline(20, color = color.gray, linestyle = hline.style_dashed)
fill(band1, band2, color = #f9cb9c0f)

band3 = hline(70, color = color.gray, linestyle = hline.style_dashed)
band4 = hline(30, color = color.gray, linestyle = hline.style_dashed)
fill(band3, band4, color = #de9ba6)

smaK = ta.sma(stochcalc, smoothK)
smaD = ta.sma(smaK, smoothD)

plot(smaK, title = "K", color = #0094ff)
plot(smaD, title = "D", color = #ff6a00)
