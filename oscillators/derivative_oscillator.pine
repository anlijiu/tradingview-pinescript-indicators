indicator("Derivative Oscillator", shorttitle = "DOSC")

rsiLength = input.int(14, title = "RSI Length")
ema1Length = input.int(5, title = "1st EMA Smoothing Length")
ema2Length = input.int(3, title = "2nd EMA Smoothing Length")
smaLength = input.int(9, title = "3rd SMA Smoothing Length")
signalLength = input.int(9, title = "Signal Length")
src = input.source(close, title = "Source")

smoothedRSI = ta.ema(ta.ema(ta.rsi(src, rsiLength), ema1Length), ema2Length)
dosc = smoothedRSI - ta.sma(smoothedRSI, smaLength)
signal = ta.sma(dosc, signalLength)

doscColor = dosc >= 0 ? dosc[1] < dosc ? #26A69A : #B2DFDB : dosc[1] < dosc ? #FFCDD2 : #EF5350
plot(dosc, title = "DOSC", style = plot.style_columns, linewidth = 2, color = doscColor)
plot(signal, title = "Signal", linewidth = 2, color = color.black)
