indicator("Total Power Indicator", shorttitle = "TPI")

length = input.int(45, title = "Length")
powersLength = input.int(10, title = "Elder Powers Length")
adjustableLevel = input.int(75, title = "Adjustable Entry Level")
applyFilling = input.bool(false, title = "Apply Powers Filling ?")

elderBullPower = high - ta.ema(close, powersLength)
elderBearPower = low - ta.ema(close, powersLength)

adjust(value) => 100 * value / length

bullCount = math.sum(elderBullPower > 0 ? 1 : 0, length)
bearCount = math.sum(elderBearPower < 0 ? 1 : 0, length)
total = adjust(math.abs(bullCount - bearCount))
bull = adjust(bullCount)
bear = adjust(bearCount)

bullPlot = plot(bull, title = "Bull", linewidth = 2, color = #0ebb23)
bearPlot = plot(bear, title = "Bear", linewidth = 2, color = color.red)
plot(total, title = "Total", linewidth = 2, color = #3c78d8)

fillColor = applyFilling ? (bull > bear ? #0ebb23 : color.red) : color.new(color.white, 100) 
fill(bullPlot, bearPlot, color = color.new(fillColor, 80))

hline(adjustableLevel, title = "Adjustable Entry Level", linestyle = hline.style_dotted)
hline(50, title = "Middle Level", linestyle = hline.style_dotted, color = #f49517)
