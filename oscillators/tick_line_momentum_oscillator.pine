indicator("Tick Line Momentum Oscillator", shorttitle="TLMO")

cumoMALength = input.int(10, title="Cumo MA Length", minval=1)
cumoMAInput = input.string("EMA", title="Cumo MA", options=["EMA", "SMA", "VWMA", "WMA"])
rocLength = input.int(5, title="ROC Length", minval=1)
smoothingLength = input.int(5, title="Smoothing Length", minval=1)
smoothingMAInput = input.string("EMA", title="Smoothing MA", options=["EMA", "SMA", "VWMA", "WMA"])
obosLevel = input.int(5, title="Overbought / Oversold Level", minval=1)
src = input.source(close, title="Source")

cumoMA = (cumoMAInput == "EMA" ? ta.ema(src, cumoMALength) : (cumoMAInput == "SMA" ? ta.sma(src, cumoMALength) : (cumoMAInput == "VWMA" ? ta.vwma(src, cumoMALength) : (cumoMAInput == "WMA" ? ta.wma(src, cumoMALength) : na))))

cumoExpression = src > nz(cumoMA[1])
	 ? 1
	 : src < nz(cumoMA[1])
	 	 ? -1
	 	 : 0

tlmo = (smoothingMAInput == "EMA" ? ta.ema(ta.roc(ta.cum(cumoExpression), rocLength), smoothingLength) : (smoothingMAInput == "SMA" ? ta.sma(ta.roc(ta.cum(cumoExpression), rocLength), smoothingLength) : (smoothingMAInput == "VWMA" ? ta.vwma(ta.roc(ta.cum(cumoExpression), rocLength), smoothingLength) : (smoothingMAInput == "WMA" ? ta.wma(ta.roc(ta.cum(cumoExpression), rocLength), smoothingLength) : na))))

tlmoColor = tlmo > obosLevel ? #0ebb23 : tlmo < -obosLevel ? #ff0000 : #674ea7
plot(tlmo, title="TLMO", linewidth=2, color=tlmoColor)

hline(obosLevel, title="Overbought", linestyle=hline.style_dotted, color=#0ebb23)
hline(0, title="Zero Level", linestyle=hline.style_solid, color=#f6b26b)
hline(-1 * obosLevel, title="Oversold", linestyle=hline.style_dotted, color=#ff0000)
