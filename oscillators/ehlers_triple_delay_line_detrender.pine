indicator("Ehlers Triple Delay-Line Detrender", shorttitle="TDLD")

src = input.source(hl2, title="Source")
showSignal = input.bool(true, title="Show Signal Line ?")
showHistogram = input.bool(false, title="Show Histogram ?")
highlightCrossovers = input.bool(true, title="Highlight Signal Crossovers ?")
highlightZeroCrossovers = input.bool(false, title="Highlight Zero Line Crossovers ?")
applyFilling = input.bool(false, title="Apply Ribbon Filling ?")

tmp1 = 0.0
tmp1 := src + .088 * nz(tmp1[6])

tmp2 = 0.0
tmp2 := tmp1 - nz(tmp1[6]) + 1.2 * nz(tmp2[6]) - 0.7 * nz(tmp2[12])

detrender = nz(tmp2[12]) - 2 * nz(tmp2[6]) + tmp2

_moef(src) =>
    src1 = nz(src[1], src)
    src2 = nz(src[2], src1)
    src3 = nz(src[3], src2)
    
    moef = src
    moef := 0.13785 * (2 * src - src1) +
             0.0007 * (2 * src1 - src2) +
             0.13785 * (2 * src2 - src3) +
             1.2103 * nz(moef[1], moef) -
             0.4867 * nz(moef[2], moef)
    moef

tdld = _moef(detrender)
signal = _moef(tdld)

hist = tdld - signal
histColor = hist >= 0 ? (hist[1] < hist ? #26a69a : #b2dfdb) : (hist[1] < hist ? #ffcdd2 : #ef5350)
plot(showHistogram ? hist : na, title="Histogram", style=plot.style_columns, color=histColor)
hline(0, title="Zero Level", linestyle=hline.style_dotted)

trendColor = tdld > signal ? #0ebb23 : color.red

tdldColor = applyFilling ? trendColor : (tdld > 0 ? #0ebb23 : color.red)
signalColor = applyFilling ? trendColor : #ff9800

tdldPlot = plot(tdld, title="TDLD", linewidth=2, color=tdldColor)
signalPlot = plot(showSignal ? signal : na, title="Signal", color=signalColor)

transparent = color.new(color.white, 100)

fillColor = applyFilling ? trendColor : transparent
fill(tdldPlot, signalPlot, color=color.new(fillColor, 70))

zeroCrossBgColor = highlightZeroCrossovers ? (tdld > 0 ? color.green : color.red) : transparent
bgcolor(color.new(zeroCrossBgColor, 80))

crossoverSignal = ta.crossover(tdld, signal)
crossunderSignal = ta.crossunder(tdld, signal)

plotshape(highlightCrossovers and crossoverSignal ? math.avg(tdld, tdld[1]) : na, title="Crossover", location=location.absolute, style=shape.circle, size=size.tiny, color=color.green)
plotshape(highlightCrossovers and crossunderSignal ? math.avg(tdld, tdld[1]) : na, title="Crossunder", location=location.absolute, style=shape.circle, size=size.tiny, color=color.red)
