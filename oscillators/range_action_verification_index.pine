indicator("Range Action Verification Index (RAVI)", shorttitle = "RAVI")

fastLength = input.int(7, title = "Fast MA Length", minval = 1)
fastMAInput = input.string("SMA", title = "Fast MA", options = ["EMA", "SMA", "VWMA", "WMA"])
slowLength = input.int(65, title = "Slow MA Length", minval = 1)
slowMAInput = input.string("SMA", title = "Slow MA", options = ["EMA", "SMA", "VWMA", "WMA"])
comparisonLookback = input.int(1, title = "Comparison Lookback", minval = 1)
src = input.source(close, title = "Source")

fastMA = (fastMAInput == "EMA" ? ta.ema(src, fastLength) : (fastMAInput == "SMA" ? ta.sma(src, fastLength) : (fastMAInput == "VWMA" ? ta.vwma(src, fastLength) : (fastMAInput == "WMA" ? ta.wma(src, fastLength) : na))))

slowMA = (slowMAInput == "EMA" ? ta.ema(src, slowLength) : (slowMAInput == "SMA" ? ta.sma(src, slowLength) : (slowMAInput == "VWMA" ? ta.vwma(src, slowLength) : (slowMAInput == "WMA" ? ta.wma(src, slowLength) : na))))

ravi = math.abs(100 * (fastMA - slowMA) / slowMA)

raviColor = ravi > nz(ravi[comparisonLookback]) ? color.green : color.red

plot(ravi, title = "RAVI", linewidth = 2, color = raviColor)
