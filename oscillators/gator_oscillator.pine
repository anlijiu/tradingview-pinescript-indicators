indicator("Gator Oscillator", shorttitle = "Gator")

jawLength = input.int(13, title = "Jaw Length")
teethLength = input.int(8, title = "Teeth Length")
lipsLength = input.int(5, title = "Lips Length")

// Shifts a series back by the given number of bars
_offset(float src, int offset) => src[offset]

jaw = _offset(ta.rma(hl2, jawLength), 8)
teeth = _offset(ta.rma(hl2, teethLength), 5)
lips = _offset(ta.rma(hl2, lipsLength), 3)

upper = math.abs(jaw - teeth)
lower = -math.abs(teeth - lips)

upperColor = (upper[1] < upper ? #26A69A : #EF5350)
lowerColor = (lower[1] > lower ? #26A69A : #EF5350)

plot(upper, title = "Upper", style = plot.style_columns, color = upperColor)
plot(lower, title = "Lower", style = plot.style_columns, color = lowerColor)
