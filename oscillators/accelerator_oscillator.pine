indicator("Accelerator Oscillator", shorttitle = "AC")

fastLength = input.int(5, title = "Fast Length")
slowLength = input.int(34, title = "Slow Length")
smoothLength = input.int(5, title = "Smoothing Length")

ao = ta.sma(hl2, fastLength) - ta.sma(hl2, slowLength)

ac = ao - ta.sma(ao, smoothLength)

acColor = ac >= 0 ? (ac[1] < ac ? #26A69A : #B2DFDB) : (ac[1] < ac ? #FFCDD2 : #EF5350)
plot(ac, title = "AC", style = plot.style_columns, color = acColor)
