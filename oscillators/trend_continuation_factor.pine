indicator("Trend Continuation Factor", shorttitle = "TCF")

length = input.int(35, title = "Length", minval = 1)
src = input.source(close, title = "Source")

plusChange(src) => ta.change(src) > 0 ? ta.change(src) : 0.0
minusChange(src) => ta.change(src) > 0 ? 0.0 : -ta.change(src)

plusCF = 0.0
plusCF := plusChange(src) == 0 ? 0.0 : plusChange(src) + nz(plusCF[1])

minusCF = 0.0
minusCF := minusChange(src) == 0 ? 0.0 : minusChange(src) + nz(minusCF[1])

plusTCF = math.sum(plusChange(src) - minusCF, length)
minusTCF = math.sum(minusChange(src) - plusCF, length)

plot(plusTCF, title = "+TCF", linewidth = 2, color = #38761d)
plot(minusTCF, title = "-TCF", linewidth = 2, color = #cc4125)

hline(0, title = "Zero Level", linestyle = hline.style_solid, color = #e69138)
