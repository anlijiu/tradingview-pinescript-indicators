indicator("Relative Spread Strength", shorttitle = "RSS")

rsiLength = input.int(14, title = "RSI Length", minval = 1)
fastLength = input.int(10, title = "Fast MA Length", minval = 1)
slowLength = input.int(40, title = "Slow MA Length", minval = 1)
smoothingLength = input.int(5, title = "Smoothing Length", minval = 1)
smoothingType = input.string("EMA", title = "Smoothing Type", options = ["EMA", "SMA"])
highLevel = input.int(80, title = "High Level", maxval = 100)
lowLevel = input.int(20, title = "Low Level", minval = 0)
highlightBreakouts = input.bool(true, title = "Highlight Overbought/Oversold Breakouts ?")
src = input.source(close, title = "Source")

spread = smoothingType == "EMA" ? ta.ema(src, fastLength) - ta.ema(src, slowLength) : ta.sma(src, fastLength) - ta.sma(src, slowLength)

rs = ta.rsi(spread, rsiLength)
rss = ta.sma(rs, smoothingLength)

rssColor = rss > highLevel ? #0ebb23 : rss < lowLevel ? #ff0000 : #f4b77d
plot(rss, title = "RSS", linewidth = 2, color = rssColor)

transparent = color.new(color.white, 100)

maxLevelPlot = hline(100, title = "Max Level", linestyle = hline.style_dotted, color = transparent)
highLevelPlot = hline(highLevel, title = "High Level", linestyle = hline.style_dotted)
hline(50, title = "Middle Level", linestyle = hline.style_dotted)
lowLevelPlot = hline(lowLevel, title = "Low Level", linestyle = hline.style_dotted)
minLevelPlot = hline(0, title = "Min Level", linestyle = hline.style_dotted, color = transparent)

fill(highLevelPlot, lowLevelPlot, color = color.new(color.purple, 95))

highFillColor = rss > highLevel and highlightBreakouts ? color.green : transparent
lowFillColor = rss < lowLevel and highlightBreakouts ? color.red : transparent

fill(maxLevelPlot, highLevelPlot, color = color.new(highFillColor, 90))
fill(minLevelPlot, lowLevelPlot, color = color.new(lowFillColor, 90))
