indicator("Phase Change Index", shorttitle="PCI")

length = input.int(35, title="Length", minval=1)
upperLevel = input.int(80, title="Upper Level")
lowerLevel = input.int(20, title="Lower Level")
highlightBreakouts = input.bool(true, title="Highlight Overbought/Oversold Breakouts ?")
applySmoothing = input.bool(false, title="Apply Smoothing ?")
smoothingType = input.string("SMA", title="Smoothing Type", options=["EMA", "SMA", "VWMA", "WMA"])
smoothingLength = input.int(3, title="Smoothing Length", minval=1)
src = input.source(close, title="Source")

getMA(src, length) =>
	ma = 0.0
	if smoothingType == "EMA"
		ma := ta.ema(src, length)
	if smoothingType == "SMA"
		ma := ta.sma(src, length)
	if smoothingType == "VWMA"
		ma := ta.vwma(src, length)
	if smoothingType == "WMA"
		ma := ta.wma(src, length)
	ma

mom = ta.change(src, length)

positiveSum = 0.0
negativeSum = 0.0

for i = 0 to length - 1
	gradient = nz(src[length]) + mom * (length - i) / (length - 1)
	deviation = nz(src[length - i]) - gradient

	if deviation > 0
		positiveSum := positiveSum + deviation
	else
		negativeSum := negativeSum - deviation

sum = positiveSum + negativeSum
pci = sum != 0 ? 100 * positiveSum / sum : 0
pci := applySmoothing ? getMA(pci, smoothingLength) : pci

pciColor = pci > upperLevel ? #0ebb23 : pci < lowerLevel ? #ff0000 : #f4b77d
plot(pci, title="PCI", linewidth=2, color=pciColor)

transparent = color.new(color.white, 100)

maxLevelPlot = hline(100, title="Max Level", linestyle=hline.style_dotted, color=transparent)
upperLevelPlot = hline(upperLevel, title="Upper Level", linestyle=hline.style_dotted)
hline(50, title="Middle Level", linestyle=hline.style_dotted)
lowerLevelPlot = hline(lowerLevel, title="Lower Level", linestyle=hline.style_dotted)
minLevelPlot = hline(0, title="Min Level", linestyle=hline.style_dotted, color=transparent)

fill(upperLevelPlot, lowerLevelPlot, color=color.new(color.purple, 95))

upperFillColor = pci > upperLevel and highlightBreakouts ? color.green : transparent
lowerFillColor = pci < lowerLevel and highlightBreakouts ? color.red : transparent

fill(maxLevelPlot, upperLevelPlot, color=color.new(upperFillColor, 90))
fill(minLevelPlot, lowerLevelPlot, color=color.new(lowerFillColor, 90))
