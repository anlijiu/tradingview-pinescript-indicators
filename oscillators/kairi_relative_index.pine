indicator("Kairi Relative Index", shorttitle = "KRI")

length = input.int(14, title = "Length", minval = 1)
src = input.source(close, title = "Source")

kri = 100 * (src - ta.sma(src, length)) / ta.sma(src, length)

plot(kri, title = "KRI", linewidth = 1, color = #134f5c)

hline(0, title = "Zero Level", linestyle = hline.style_dotted, color = #989898)
