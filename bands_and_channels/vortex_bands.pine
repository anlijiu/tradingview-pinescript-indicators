const string INDICATOR_SHORT_TITLE = 'VB'
indicator('Vortex Bands', shorttitle = INDICATOR_SHORT_TITLE, overlay = true, behind_chart = false)

const string calcGroup = 'Calculation'
length = input.int(20, minval = 1, title = 'Length', group = calcGroup)
mult = input.float(2, step = 0.1, title = 'Multiplier', group = calcGroup)
src = input.source(hlc3, title = 'Source', group = calcGroup)

const string visualGroup = 'Visuals'
const string barColoringTypeTooltip = 'Colors price bars according to the selected ' + INDICATOR_SHORT_TITLE + ' condition'
barColoringType = input.string(
     'None'
     , title = 'Bar Coloring'
     , options = ['None', 'Upper > Lower', 'Close Above/Below Basis', 'Close Inside Cloud', 'Wicks Inside Cloud']
     , tooltip = barColoringTypeTooltip
     , group = visualGroup
     )

//---

_ema(float src, float alpha) =>
    out = src
    out := alpha * out + (1 - alpha) * nz(out[1], out)
    out

// McNicholl Moving Average
_mnma(float src, int length) =>
    alpha = 2 / (length + 1)
    ema1 = _ema(src, alpha)
    ema2 = _ema(ema1, alpha)
    out = ((2 - alpha) * ema1 - ema2) / (1 - alpha)
    out

//---

basis = _mnma(src, length)
deviation = mult * _mnma(src - basis, length)

upper = basis + deviation
lower = basis - deviation

//---

const color basisColor = color.maroon
const color upperBandColor = #1565c0
const color lowerBandColor = #ef6c00
const color cloudFillColor = color.new(#ffd966, 90)

const color positiveColor = color.lime
const color negativeColor = color.red

//---

plot(basis, title = 'Basis', color = basisColor)
upperBandPlot = plot(upper, title = 'Upper', linewidth = 2, color = upperBandColor)
lowerBandPlot = plot(lower, title = 'Lower', linewidth = 2, color = lowerBandColor)

fill(upperBandPlot, lowerBandPlot, title = 'Background', color = cloudFillColor)

cloudTop = math.max(upper, lower)
cloudBottom = math.min(upper, lower)

barColor = barColoringType == 'Upper > Lower' ? (upper > lower ? positiveColor : negativeColor) : barColoringType == 'Close Above/Below Basis' ? (close > basis ? positiveColor : negativeColor) : barColoringType == 'Close Inside Cloud' ? (cloudBottom < close and close < cloudTop ? positiveColor : negativeColor) : barColoringType == 'Wicks Inside Cloud' ? (cloudBottom < low and high < cloudTop ? positiveColor : negativeColor) : na

barcolor(barColor, title = 'Bar Color')

//---

alertcondition(ta.crossover(close, upper), title = 'Close Above Upper Band', message = INDICATOR_SHORT_TITLE + ' - Close crossed above the upper band\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}')
alertcondition(ta.crossunder(close, lower), title = 'Close Below Lower Band', message = INDICATOR_SHORT_TITLE + ' - Close crossed below the lower band\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}')
