const string INDICATOR_SHORT_TITLE = "STARC"
indicator("Stoller Average Range Channels (STARC) Bands", shorttitle = INDICATOR_SHORT_TITLE, overlay = true, behind_chart = false)

const string calcGroup = "Calculation"
length = input.int(6, minval = 1, title = "Length", group = calcGroup)
atrLength = input.int(15, minval = 1, title = "ATR Length", group = calcGroup)
mult = input.float(1.33, step = 0.1, title = "Multiplier", group = calcGroup)
src = input.source(close, title = "Source", group = calcGroup)
maInput = input.string("SMA", title = "MA", options = ["EMA", "SMA", "VWMA", "WMA"], group = calcGroup)

//---

_getMA(float src, int length, string maType) =>
    maType == "EMA" ? ta.ema(src,
        length) : maType == "SMA" ? ta.sma(src,
        length) : maType == "VWMA" ? ta.vwma(src,
        length) : maType == "WMA" ? ta.wma(src,
        length) : na

basis = _getMA(src, length, maInput)

atr = ta.atr(atrLength)

upperBand = basis + atr * mult
lowerBand = basis - atr * mult

//---

const color upperBandColor = #1565c0
const color basisColor = #6d1e7f
const color lowerBandColor = #c62828

//---

upperBandPlot = plot(upperBand, title = "Upper", linewidth = 2, color = upperBandColor)
plot(basis, title = "Basis", linewidth = 2, color = basisColor)
lowerBandPlot = plot(lowerBand, title = "Lower", linewidth = 2, color = lowerBandColor)

fill(upperBandPlot, lowerBandPlot, title = "Background", color = color.new(basisColor, 92))

//---

alertcondition(ta.crossover(close, upperBand),
    title = "Close Above Upper Band",
    message = INDICATOR_SHORT_TITLE + " - Close crossed above the upper band\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}")
alertcondition(ta.crossunder(close, lowerBand),
    title = "Close Below Lower Band",
    message = INDICATOR_SHORT_TITLE + " - Close crossed below the lower band\nSymbol: {{exchange}}:{{ticker}}\nPrice: {{close}}")
