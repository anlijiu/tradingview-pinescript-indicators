indicator("Moving Average Channel", shorttitle="MAC", overlay=true)

upperSrc = input.source(high, title="Upper Source")
upperLength = input.int(20, title="Upper Length")
upperOffset = input.int(0, title="Upper Offset")

upper = ta.sma(upperSrc, upperLength)
upperPlot = plot(upper, title="Upper", color=#3c78d8, offset=upperOffset)

lowerSrc = input.source(low, title="Lower Source")
lowerLength = input.int(20, title="Lower Length")
lowerOffset = input.int(0, title="Lower Offset")

lower = ta.sma(lowerSrc, lowerLength)
lowerPlot = plot(lower, title="Lower", color=#f57c00, offset=lowerOffset)

fill(upperPlot, lowerPlot, title="Background", color=color.new(#ffd966, 90))

barColor = close > upper ? color.lime : close < lower ? color.red : color.gray
barcolor(barColor, title="Bar Color")
