indicator("Quarters", overlay=true)

transparency = input.int(88, title="Transparency", minval=0, maxval=100)
showLabels = input.bool(true, title="Show Labels ? ")

transparent = color.new(color.white, 100)
labelColor = #1e90ff

m = month(time)

q1Text = " Q1 "
q1Start = m[1] == 12 and m == 1
q1 = m == 1 or m == 2 or m == 3
plotshape(showLabels and q1Start, title=q1Text, text=q1Text, color=labelColor, textcolor=color.white, style=shape.labelup, location=location.belowbar, size=size.small)
bgcolor(title="Q1", color=color.new(q1 ? #e6194b : transparent, transparency))

q2Text = " Q2 "
q2Start = m[1] == 3 and m == 4
q2 = m == 4 or m == 5 or m == 6
plotshape(showLabels and q2Start, title=q2Text, text=q2Text, color=labelColor, textcolor=color.white, style=shape.labelup, location=location.belowbar, size=size.small)
bgcolor(title="Q2", color=color.new(q2 ? #3cb44b : transparent, transparency))

q3Text = " Q3 "
q3Start = m[1] == 6 and m == 7
q3 = m == 7 or m == 8 or m == 9
plotshape(showLabels and q3Start, title=q3Text, text=q3Text, color=labelColor, textcolor=color.white, style=shape.labelup, location=location.belowbar, size=size.small)
bgcolor(title="Q3", color=color.new(q3 ? #ffe119 : transparent, transparency))

q4Text = " Q4 "
q4Start = m[1] == 9 and m == 10
q4 = m == 10 or m == 11 or m == 12
plotshape(showLabels and q4Start, title=q4Text, text=q4Text, color=labelColor, textcolor=color.white, style=shape.labelup, location=location.belowbar, size=size.small)
bgcolor(title="Q4", color=color.new(q4 ? #f58231 : transparent, transparency))
