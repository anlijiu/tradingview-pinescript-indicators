indicator("Range Candles", overlay = true)

var color bullColor = input.color(#26a69a, title = "Bull Color")
var color bearColor = input.color(#ef5350, title = "Bear Color")
candleColor = close >= open ? bullColor : bearColor

plotcandle(
     open,
     high,
     low,
     close,
     title = "",
     color = candleColor,
     bordercolor = candleColor,
     wickcolor = candleColor
     )
