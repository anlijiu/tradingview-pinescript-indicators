indicator("BitMEX Withdrawals Cutoff Time", overlay=true)

transparency = input.int(70, title="Transparency", minval=0)

cutoff = hour(time) == 13
transparent = color.new(color.white, 100)

bgcolor(color.new(cutoff ? #f57f17 : transparent, transparency), title="Cutoff Time")